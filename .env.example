# Core
APP_ENV=production
NODE_ENV=production
PORT=5000
APP_BASE_URL=http://127.0.0.1:5000
FINCOACH_ENV=production
FINCOACH_CLOUD_DEPLOYMENT=false
FINCOACH_PRESENTATION_TIMEZONE=America/New_York
FINCOACH_BUILD_COMMIT=
FINCOACH_BUILD_ID=
MARKETPILOT_DEMO_ONLY=true
MARKETPILOT_RUN_MODE=demo_observation

# Required production
DATABASE_URL=
OANDA_ENV=practice
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_BASE_URL=https://api-fxpractice.oanda.com/v3

# Execution safety
FINCOACH_LIVE_EXECUTION_ENABLED=false
FINCOACH_PAPER_EXECUTION_ENABLED=false
FINCOACH_DEMO_BROKER_EXECUTION_ENABLED=false
FINCOACH_V2_FORWARD_TESTING_ENABLED=false
FINCOACH_V2_RESEARCH_SIGNAL_ENABLED=false
FINCOACH_V2_TELEGRAM_SIGNAL_PUBLICATION_ENABLED=false
TELEGRAM_DELIVERY_ENABLED=false
TELEGRAM_SIGNALS_ENABLED=false
OANDA_VALIDATION_ALLOW_EXTERNAL_TRADE=false

# V2 research runtime
FINCOACH_V2_RUNTIME_ENABLED=true
FINCOACH_V2_RESEARCH_ENABLED=true
FINCOACH_V2_PILOT_ENABLED=true
FINCOACH_V2_AUTOSTART=true
FINCOACH_V2_RESEARCH_DATA_MODE=provider
FINCOACH_V2_PILOT_ID=v2-bounded-paper-research
FINCOACH_V2_OBSERVATION_SYMBOLS=EUR_USD,GBP_USD,AUD_USD,NZD_USD,USD_JPY,USD_CHF,USD_CAD
FINCOACH_V2_OBSERVATION_TIMEFRAMES=1m,5m,15m,30m,1h,3h,6h,1d,1w
FINCOACH_V2_CADENCE_MS=3600000
FINCOACH_V2_MAX_CYCLES_PER_DAY=25
FINCOACH_V2_TARGET_EVALUATIONS_PER_HOUR=200
FINCOACH_V2_MIN_EVALUATIONS_PER_HOUR=100
FINCOACH_V2_MAX_OBSERVATIONS_PER_CYCLE=400
FINCOACH_V2_MAX_HYPOTHESES_PER_CYCLE=5
FINCOACH_V2_MAX_EXPERIMENTS_PER_CYCLE=3
FINCOACH_V2_MAX_BACKTESTS_PER_CYCLE=3
FINCOACH_V2_MAX_ACTIVE_FORWARD_TESTS=3
FINCOACH_V2_MAX_ACTIVE_RESEARCH_SIGNALS=3
FINCOACH_V2_MAX_TEMPLATES_PER_SYMBOL_SESSION=3
FINCOACH_V2_MAX_VARIANTS_PER_TEMPLATE=1
FINCOACH_V2_MAX_CANDIDATES_PER_FAMILY_PER_CYCLE=4
FINCOACH_V2_MAX_CANDIDATES_PER_SYMBOL_PER_CYCLE=4
FINCOACH_V2_MIN_INDEPENDENT_HYPOTHESIS_OCCURRENCES=2
FINCOACH_V2_HYPOTHESIS_LOOKBACK_HOURS=720
FINCOACH_V2_MIN_BACKTEST_TRADES=100
FINCOACH_V2_MIN_BACKTEST_DAYS=90
FINCOACH_V2_MIN_FORWARD_TEST_TRADES=30
FINCOACH_V2_MIN_FORWARD_TEST_DAYS=14
FINCOACH_V2_MIN_PROFIT_FACTOR=1.2
FINCOACH_V2_MAX_DRAWDOWN_PCT=10
FINCOACH_V2_MIN_SHARPE_RATIO=0.5
FINCOACH_V2_REQUIRE_HUMAN_LIVE_APPROVAL=true
FINCOACH_V2_MAX_PAPER_POSITIONS=0
FINCOACH_V2_MAX_PAPER_RISK_PER_POSITION=0
FINCOACH_V2_MAX_PAPER_DAILY_LOSS=0
FINCOACH_V2_PROVIDER_CALL_BUDGET=50
FINCOACH_V2_PROVIDER_REQUESTS_PER_MINUTE=60
FINCOACH_V2_DATABASE_WRITE_BUDGET=200
FINCOACH_V2_RETRY_BUDGET=3
FINCOACH_V2_CYCLE_TIMEOUT_MS=120000
FINCOACH_V2_MEMORY_RETENTION_LIMIT=1000
FINCOACH_V2_LEASE_TTL_MS=60000
FINCOACH_V2_LEASE_RENEW_INTERVAL_MS=20000
FINCOACH_V2_OBSERVATION_MAX_CONCURRENCY=4
FINCOACH_V2_OBSERVATION_BATCH_SIZE=25

# Research schedule and snapshots
FINCOACH_WEEKLY_RESEARCH_SCHEDULE_ENABLED=true
FINCOACH_WEEKLY_RESEARCH_TIMEZONE=UTC
FINCOACH_WEEKLY_RESEARCH_OPEN_DAY=0
FINCOACH_WEEKLY_RESEARCH_OPEN_TIME=21:00
FINCOACH_WEEKLY_RESEARCH_CLOSE_DAY=5
FINCOACH_WEEKLY_RESEARCH_CLOSE_TIME=21:00
FINCOACH_WEEKLY_RESEARCH_START_LEAD_MINUTES=5
FINCOACH_CONTINUOUS_MARKET_WEEKLY_PAUSE_ENABLED=true
FINCOACH_CONTINUOUS_MARKET_WEEKLY_PAUSE_DAY=5
FINCOACH_CONTINUOUS_MARKET_WEEKLY_PAUSE_TIME=21:00
FINCOACH_CONTINUOUS_MARKET_WEEKLY_RESUME_DAY=0
FINCOACH_CONTINUOUS_MARKET_WEEKLY_RESUME_TIME=21:00
FINCOACH_MARKET_SNAPSHOT_ENABLED=true
FINCOACH_MARKET_SNAPSHOT_TIMEZONE=America/New_York
FINCOACH_MARKET_SNAPSHOT_MORNING_TIME=08:00
FINCOACH_MARKET_SNAPSHOT_EVENING_TIME=20:00
FINCOACH_MARKET_SNAPSHOT_INCLUDE_WEEKENDS=true
FINCOACH_MARKET_SNAPSHOT_MAX_EVENTS=12
FINCOACH_MARKET_SNAPSHOT_LOOKAHEAD_HOURS=24

# Storage and logging
MARKETPILOT_STORAGE=memory
MARKETPILOT_TIMESCALE=
QDRANT_URL=
REDIS_URL=
FINCOACH_LOG_DIR=logs
FINCOACH_LOG_MAX_BYTES=10485760
FINCOACH_LOG_RETENTION_DAYS=14
FINCOACH_EVENT_LOG_RETENTION_LIMIT=5000
FINCOACH_STRATEGY_EVIDENCE_RETENTION_LIMIT=5000
FINCOACH_REJECTED_SIGNAL_RETENTION_LIMIT=1000
FINCOACH_TELEGRAM_DIGEST_RETENTION_LIMIT=25
FINCOACH_TELEGRAM_NOTIFIED_RETENTION_LIMIT=1000
FINCOACH_TELEGRAM_PENDING_RETENTION_LIMIT=100

# Local Postgres container
POSTGRES_IMAGE=postgres:16
POSTGRES_RESTART_POLICY=unless-stopped
POSTGRES_USER=fincoach
POSTGRES_PASSWORD=
POSTGRES_DB=fincoach
POSTGRES_HOST_PORT=5434
POSTGRES_CONTAINER_PORT=5432
POSTGRES_CONTAINER_NAME=fincoach-postgres
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=768MB
POSTGRES_MAINTENANCE_WORK_MEM=64MB
POSTGRES_CHECKPOINT_COMPLETION_TARGET=0.9
POSTGRES_WAL_BUFFERS=16MB
POSTGRES_DEFAULT_STATISTICS_TARGET=100
POSTGRES_RANDOM_PAGE_COST=1.1
POSTGRES_WORK_MEM=4MB
POSTGRES_HEALTHCHECK_INTERVAL=10s
POSTGRES_HEALTHCHECK_TIMEOUT=5s
POSTGRES_HEALTHCHECK_RETRIES=5
POSTGRES_HEALTHCHECK_START_PERIOD=20s

# Telegram long polling
FINCOACH_TELEGRAM_TRANSPORT=disabled
FINCOACH_TELEGRAM_POLL_LOCK_PATH=/tmp/fincoach-telegram-getupdates.lock
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
TELEGRAM_CHAT_ID=
TELEGRAM_SIGNAL_CHAT_ID=
TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_MARKET_SESSION_ALERTS=false
TELEGRAM_ALLOW_GROUPS=false
TELEGRAM_DAILY_SUMMARY_HOUR_UTC=22
TELEGRAM_WEEKLY_SUMMARY_DAY=0
TELEGRAM_WEEKLY_SUMMARY_HOUR_UTC=22
TELEGRAM_MIN_SIGNAL_CONFIDENCE=75
TELEGRAM_MIN_SIGNAL_EVIDENCE_SCORE=0.75
TELEGRAM_SIGNAL_COOLDOWN_MINUTES=60
TELEGRAM_SIGNAL_SIGNING_SECRET=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# Optional integrations
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
FRED_API_KEY=
METATRADER_DEMO_BRIDGE_URL=
METATRADER_DEMO_BRIDGE_SECRET=
TRADINGVIEW_WEBHOOK_SECRET=
GENERIC_REST_BROKER_BASE_URL=
MARKETPILOT_AUDIT_EXPORT_DIR=
MARKETPILOT_AUDIT_EXPORT_SIGNING_KEY=
MARKETPILOT_AUDIT_ARCHIVE_DIR=
MARKETPILOT_RELIABILITY_STATE_FILE=

# Operations and recovery
FINCOACH_DB_BACKUP_DIR=/tmp/fincoach-db-backups
FINCOACH_DB_BACKUP_MAX_AGE_HOURS=24
FINCOACH_DB_BACKUP_PATH=
FINCOACH_DB_BACKUP_SHA256_PATH=
FINCOACH_DB_MIGRATION_LOCK_TIMEOUT_MS=0
FINCOACH_DB_BREAK_GLASS_DESTRUCTIVE_DDL=false
FINCOACH_ALLOW_DISPOSABLE_DB_MIGRATION_WITHOUT_BACKUP=false
FINCOACH_ALLOW_LOCAL_SCHEMA_PUSH=false
FINCOACH_PG_DUMP_BIN=
FINCOACH_PG_RESTORE_BIN=
FINCOACH_POSTGRES_CONTAINER=
FINCOACH_POSTGRES_TOOL_MODE=
FINCOACH_REPLAY_MIN_FREE_DISK_GB=1
FINCOACH_REPLAY_MIN_MEMORY_GB=1
FINCOACH_REPLAY_MIN_POSTGRES_FREE_GB=1
MARKETPILOT_DISASTER_RECOVERY_DIR=
MARKETPILOT_DISASTER_RECOVERY_RESTORE_TEST_COMPLETE=false
MARKETPILOT_INCIDENT_RESPONSE_DRILL_COMPLETE=false
MARKETPILOT_INCIDENT_RESPONSE_RUNBOOK_ACKNOWLEDGED=false
MARKETPILOT_ALLOW_TELEGRAM_WEBHOOK_SETUP=false
